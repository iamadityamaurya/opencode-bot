# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
# Comma-separated list of numeric Telegram User IDs allowed to access the bot
TELEGRAM_ALLOWED_USER_IDS="123456789,987654321"

# OpenCode Server Configuration (V2 API at /api/*, HTTP basic auth)
OPENCODE_BASE_URL="http://127.0.0.1:4096"
# Server password; must also be set in the environment that runs 'opencode serve'
OPENCODE_SERVER_PASSWORD=""
# Basic auth username (defaults to "opencode")
OPENCODE_SERVER_USERNAME="opencode"

# Storage and Logging
DATABASE_PATH="./data/bot.sqlite3"
CONFIG_PATH="./config.toml"
LOG_LEVEL="INFO"
